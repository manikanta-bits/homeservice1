# Copy to .env for `docker compose --profile app up`. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# --- database
DB_USERNAME=sahayak
DB_PASSWORD=sahayak_dev_pw
MYSQL_ROOT_PASSWORD=root_dev_pw
DB_POOL_SIZE=10

# --- security (REQUIRED, >= 32 random bytes, base64)
JWT_SECRET=
CODE_PEPPER=
JWT_ISSUER=sahayak-api
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- mail (compose overrides host/port to Mailpit)
MAIL_FROM=Sahayak <no-reply@sahayak.local>
MAIL_USERNAME=
MAIL_PASSWORD=

# --- first admin (remove after first boot in real environments)
ADMIN_BOOTSTRAP_EMAIL=admin@sahayak.local
ADMIN_BOOTSTRAP_PASSWORD=

# --- observability
TRACING_SAMPLING=1.0
